# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Database (SQLite path - will be auto-created)
DATABASE_PATH=./data/rsc.db

# Email (SMTP - see Nodemailer docs)
# Leave blank in development to log emails to the console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Regent Summer Camp <noreply@regent.edu>"

# Default admin account (created on first run if no admin exists)
DEFAULT_ADMIN_EMAIL=admin@regent.edu
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
